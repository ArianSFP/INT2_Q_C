* text=auto

# Human-authored text uses a stable line ending across platforms.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
requirements.txt text eol=lf
third_party/QWEN_LICENSE text eol=lf

# Binary codec artifacts must never be filtered.
*.npz binary
*.plrsv2 binary

# These trees contain byte-hashed canonical evidence and implementations.
# Preserve their bytes exactly; do not let core.autocrlf rewrite them.
results/** -text
frozen/** -text
src/** -text
tools/run_qwen_panel.py -text

# STRATA-XKLT-SC v2 canonical frozen paths and one-shot evidence.
strata_v2_codec/** -text
blind_protocol_v2/** -text
strata_v2_blind_one_shot_v2/** -text
strata_v2_allocation_research/** -text
strata_v2_dev/** -text
strata_v2_*.json -text
strata_v2_klt_known_n20_independent_validation_v1.py -text
release/** -text
agent_polaris_qwen_rht_encoder.py -text
bg_codec_bec_encoder.py -text
strata_v2_klt_mixed_independent_auditor_v1.py -text
strata_v2_klt_lineage_tamper_tests_v1.py -text
tools/verify_strata_v2_release.py -text
